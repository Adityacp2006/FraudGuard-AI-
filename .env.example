# Copy this file to `.env` and fill in values as needed.
# `.env` is git-ignored - never commit real secrets.

# ---------------------------------------------------------------------------
# Phase 1 - dataset inspection & profiling (used now)
# ---------------------------------------------------------------------------
# Where the HHGOA dataset lives. Relative paths are resolved from the project root.
DATA_DIR=data

# Where generated Markdown/JSON reports are written.
REPORTS_DIR=reports

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# A file at or above this size (MB) is treated as "large" for profiling.
LARGE_FILE_MB=150

# For wide files, columns are profiled in batches of this size to bound memory.
COLUMN_BATCH_SIZE=60

# A column with at most this many distinct values is treated as "low cardinality"
# (its full value counts are computed and shown in the profiling report).
LOW_CARDINALITY_MAX=25

# CSV parsing engine: "c" (default, most predictable) or "pyarrow" (faster, used
# with an automatic fallback to "c" if it fails on a given file).
CSV_ENGINE=c

# ---------------------------------------------------------------------------
# Phase 2 - TigerGraph (not used yet - filled in when the schema/loading phase starts)
# ---------------------------------------------------------------------------
# TG_HOST=https://your-workspace.i.tgcloud.io
# TG_GRAPH=fraud_investigation
# TG_USERNAME=
# TG_SECRET=

# ---------------------------------------------------------------------------
# Phase 4 - AI agent / GraphRAG (not used yet)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Phase 5 - frontend / API (not used yet)
# ---------------------------------------------------------------------------
# APP_PORT=8000
